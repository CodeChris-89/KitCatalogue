# Host port to expose (change if port 3000 is already in use on your host)
PORT=3000

# Directory where database, photos, and manuals will be stored
# - Standard Linux / VPS / Docker Desktop: ./data (or /var/lib/kit-catalogue)
# - Unraid: /mnt/user/appdata/kit-catalogue
DATA_PATH=./data

# Container user/group permissions
# - Standard Linux / VPS: PUID=1000, PGID=1000
# - Unraid (nobody:users): PUID=99, PGID=100
PUID=1000
PGID=1000
TZ=UTC
